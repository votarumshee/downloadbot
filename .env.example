# Copy to .env and replace secrets. Never commit .env.
POSTGRES_PASSWORD=replace-with-random-database-password
DOWNLOADBOT_DATABASE_URL=postgresql://downloadbot:replace-with-random-database-password@127.0.0.1:5432/downloadbot
DOWNLOADBOT_API_KEY=replace-with-random-api-key-at-least-24-characters
DOWNLOADBOT_ENCRYPTION_KEY=replace-with-generated-fernet-key
DOWNLOADBOT_CLIENTS_JSON=[]
DOWNLOADBOT_DATA_DIR=data
DOWNLOADBOT_MAX_FILE_BYTES=104857600
DOWNLOADBOT_MAX_DURATION_SECONDS=1800
DOWNLOADBOT_DOWNLOAD_TIMEOUT_SECONDS=300
DOWNLOADBOT_RETENTION_SECONDS=86400
DOWNLOADBOT_MAX_ACTIVE_JOBS=100
DOWNLOADBOT_MAX_ACTIVE_JOBS_PER_CLIENT=10
DOWNLOADBOT_MAX_ATTEMPTS=2
DOWNLOADBOT_WORKER_POLL_SECONDS=1
DOWNLOADBOT_LEASE_SECONDS=60
DOWNLOADBOT_ACCOUNT_COOLDOWN_SECONDS=10
DOWNLOADBOT_MIN_FREE_DISK_BYTES=268435456
# DOWNLOADBOT_FFMPEG_LOCATION=/usr/bin/ffmpeg
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_IDS=123456789
# DOWNLOADBOT_API_URL=http://127.0.0.1:8000
